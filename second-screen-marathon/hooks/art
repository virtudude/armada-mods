#!/usr/bin/python3
"""Turns the status display's pictures in the game's shapes file into PNG files for the view.

Nothing of the game ships in the mod.
"""
import os, struct, sys, zlib

SHAPES = os.path.join(os.environ["ARMADA_MOD_GAME_DIR"], "Shapes.shps")
OUT = os.path.join(os.environ["ARMADA_MOD_DATA_DIR"], "art")
# the shield and oxygen bars are stored standing up: these are also written lying down
BARS = (1, 3, 4, 54, 55)

stamp = os.path.join(OUT, "stamp")
try:
    mark = "2 " + str(os.stat(SHAPES).st_mtime_ns)
    if open(stamp).read() == mark:
        sys.exit(0)
except OSError:
    pass


def png(width, height, rgba):
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
    rows = b"".join(b"\0" + rgba[y * width * 4:(y + 1) * width * 4] for y in range(height))
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)) + \
        chunk(b"IDAT", zlib.compress(rows, 9)) + chunk(b"IEND", b"")


def resource(data, kind, number):
    """One resource from a classic Mac file kept as MacBinary: a 128-byte header, the data fork, then the resource fork."""
    fork = data[128 + (struct.unpack_from(">I", data, 83)[0] + 127) // 128 * 128:]
    contents, table = struct.unpack_from(">II", fork)
    types = table + struct.unpack_from(">H", fork, table + 24)[0]
    for i in range(struct.unpack_from(">h", fork, types)[0] + 1):
        name, count, first = struct.unpack_from(">4sHH", fork, types + 2 + 8 * i)
        for j in range(count + 1):
            found, _, at = struct.unpack_from(">hHI", fork, types + first + 12 * j)
            if name == kind and found == number:
                at = contents + (at & 0xffffff)
                return fork[at + 4:at + 4 + struct.unpack_from(">I", fork, at)[0]]
    raise KeyError(number)


# collection 0 is the status display: a header, a colour table, and pictures of one byte per pixel, row by row
shapes = resource(open(SHAPES, "rb").read(), b".256", 128)
colors, _, color_table = struct.unpack_from(">hhi", shapes, 6)
pictures, picture_table = struct.unpack_from(">hi", shapes, 26)
palette = [bytes(v >> 8 for v in struct.unpack_from(">HHH", shapes, color_table + 8 * i + 2)) + b"\xff" for i in range(colors)]
os.makedirs(OUT, exist_ok=True)
for index in range(pictures):
    at = struct.unpack_from(">i", shapes, picture_table + 4 * index)[0]
    width, height, row_bytes = struct.unpack_from(">hhh", shapes, at)
    if row_bytes != width:
        continue
    start = at + 30 + 4 * height      # after the picture's header and its table of rows
    # colour 0 is see-through
    rows = [[palette[c] if 0 < c < colors else b"\0\0\0\0" for c in shapes[start + y * width:start + (y + 1) * width]] for y in range(height)]
    with open(os.path.join(OUT, f"{index}.png"), "wb") as f:
        f.write(png(width, height, b"".join(b"".join(row) for row in rows)))
    if index in BARS:
        with open(os.path.join(OUT, f"bar{index}.png"), "wb") as f:
            f.write(png(height, width, b"".join(rows[height - 1 - y][x] for x in range(width) for y in range(height))))
with open(stamp, "w") as f:
    f.write(mark)
